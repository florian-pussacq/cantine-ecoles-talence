{
  "name": "cantine",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run budget",
    "preview": "vite preview",
    "budget": "node scripts/check-budget.js",
    "format": "prettier --write .",
    "validate": "prettier --check . && eslint . && node scripts/generate-types.js --check && node scripts/validate-data.js && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "prepare": "svelte-kit sync",
    "types": "node scripts/generate-types.js",
    "data": "node scripts/validate-data.js",
    "data:index": "node scripts/validate-data.js --write-index"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
